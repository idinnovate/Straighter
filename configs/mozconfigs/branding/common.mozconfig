# shellcheck shell=bash
# Common branding

set -euo pipefail

# Make it Straighter (based on IronFox)...
ac_add_options --with-distribution-id='com.s9i'
export MOZ_APP_VENDOR='Straighter'
export MOZ_SOURCE_CHANGESET="${IRONFOX_REVISION}"
export MOZ_SOURCE_REPO='https://github.com/idinnovate/Straighter'
