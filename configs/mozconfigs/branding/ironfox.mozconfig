# shellcheck shell=bash
# IronFox

set -euo pipefail

. "${IRONFOX_MOZCONFIGS}/branding/common.mozconfig"

ac_add_options --enable-ironfox-release
ac_add_options --with-app-basename='Straighter'
ac_add_options --with-app-name='ironfox'
ac_add_options --with-branding='ironfox/branding/ironfox'
export MOZ_APP_BASENAME='Straighter'
export MOZ_APP_NAME='ironfox'
export MOZ_APP_REMOTINGNAME='ironfox'
