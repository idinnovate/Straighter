# Example only. tools/signing/generate-keystore.sh writes the real file to
# ~/.straighter-signing/signing.env, outside this repository.
#
# When all four variables are set, the IronFox build scripts sign the output APKs
# automatically (IRONFOX_SIGN becomes 1 in scripts/env_common.sh).

# The keystore file
export IRONFOX_ANDROID_KEYSTORE="$HOME/.straighter-signing/straighter-release.jks"
# A file whose only content is the keystore password
export IRONFOX_ANDROID_KEYSTORE_PASS_FILE="$HOME/.straighter-signing/keystore.pass"
# The key's alias inside the keystore
export IRONFOX_ANDROID_KEYSTORE_KEY_ALIAS="straighter"
# A file whose only content is the key's password. A PKCS12 keystore uses one password for
# both, so this is the same file as above.
export IRONFOX_ANDROID_KEYSTORE_KEY_PASS_FILE="$HOME/.straighter-signing/keystore.pass"
